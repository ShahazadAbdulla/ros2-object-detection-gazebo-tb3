<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tb3_gazebo_worlds</name>
  <version>0.0.0</version>
  <description>simple gazebo world and tb3 launching together</description>
  <maintainer email="Shahazad.abdulla.engineer@gmail.com">shadow0</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gazebo_ros</depend>
  <depend>rclpy</depend>
  <depend>launch_ros</depend>

  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend> <!-- Since we might want to reference TB3 gazebo launch -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
